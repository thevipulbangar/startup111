rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin uploads/deletes from the website. Tablets download via the tokenized download URL.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email_verified
        && request.auth.token.email in ['vipulbangar01@gmail.com'];
    }
  }
}
