rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the admin Google account(s) can use the website. Phones and tablets go through the
    // Cloud Function (functions/index.js), which uses admin access and checks the fleet key.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified
        && request.auth.token.email in ['vipulbangar01@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
